generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum CategoryType {
  ATHLETE
  SENIOR
  GYM_FREAK
  NORMAL
}

enum PlanTier {
  BASIC
  FREEMIUM
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PartnerType {
  GYM
  HOSPITAL
  NUTRITION
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  role           Role      @default(USER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile                 UserProfile?
  healthConditions        UserHealthCondition[]
  allergies               UserAllergy[]
  medications             UserMedication[]
  onboardingResponses     OnboardingResponse[]
  fitnessGoals            FitnessGoal[]
  workoutLogs             WorkoutLog[]
  waterIntakeLogs         WaterIntakeLog[]
  sleepLogs               SleepLog[]
  habitLogs               HabitLog[]
  habitStreak             HabitStreak?
  medicineReminders       MedicineReminder[]
  notificationPreferences NotificationPreference?
  wearableConnections     WearableConnection[]
  wearableMeasurements    WearableMeasurement[]
  subscriptions           Subscription[]
  payments                Payment[]
  partnerBookings         PartnerBooking[]
  emergencyContacts       EmergencyContact[]
  aiConversations         AIConversation[]
  consentRecords          ConsentRecord[]
  auditLogs               AuditLog[]

  @@map("users")
}

model UserProfile {
  id                String        @id @default(uuid())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  age               Int?
  dob               DateTime?
  gender            String?
  heightCm          Float?
  weightKg          Float?
  country           String?       @default("India")
  location          String?
  activityLevel     String?
  selectedCategory  CategoryType?
  somatotype        String?
  emergencyPhone    String?
  emergencyName     String?
  emergencyRelation String?
  emergencyConsent  Boolean       @default(false)
  seniorModeEnabled Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("user_profiles")
}

model UserHealthCondition {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conditionName String
  severity      String?
  notes         String?
  createdAt     DateTime @default(now())

  @@map("user_health_conditions")
}

model UserAllergy {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergen    String
  allergyType String?
  reaction    String?
  createdAt   DateTime @default(now())

  @@map("user_allergies")
}

model UserMedication {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicationName String
  dosage         String
  frequency      String?
  createdAt      DateTime @default(now())

  @@map("user_medications")
}

model OnboardingResponse {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      CategoryType
  responsesJson Json
  completedAt   DateTime     @default(now())

  @@map("onboarding_responses")
}

model FitnessGoal {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetGoal   String
  targetWeight Float?
  targetDate   DateTime?
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())

  @@map("fitness_goals")
}

model WorkoutPlan {
  id          String       @id @default(uuid())
  category    CategoryType
  title       String
  description String
  level       String       @default("Beginner")
  daysPerWeek Int          @default(3)
  createdAt   DateTime     @default(now())

  @@map("workout_plans")
}

model ExerciseLibrary {
  id                String        @id @default(uuid())
  name              String
  category          CategoryType?
  muscleGroup       String
  instructions      String
  durationSeconds   Int?
  sets              Int?
  reps              Int?
  restSeconds       Int?          @default(60)
  difficulty        String        @default("Beginner")
  estimatedCalories Float         @default(50.0)
  mediaUrl          String?
  safetyNotes       String?
  modifications     String?
  isSeniorFriendly  Boolean       @default(false)
  createdAt         DateTime      @default(now())

  workoutLogs WorkoutLog[]

  @@map("exercise_library")
}

model WorkoutLog {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId      String?
  exercise        ExerciseLibrary? @relation(fields: [exerciseId], references: [id])
  workoutTitle    String
  durationMinutes Int
  caloriesBurned  Float
  feedback        String?
  completedAt     DateTime         @default(now())

  @@map("workout_logs")
}

model NutritionPlan {
  id             String       @id @default(uuid())
  category       CategoryType
  title          String
  caloriesTarget Int
  proteinGrams   Int
  carbsGrams     Int
  fatsGrams      Int
  notes          String?
  createdAt      DateTime     @default(now())

  @@map("nutrition_plans")
}

model Recipe {
  id               String        @id @default(uuid())
  title            String
  category         CategoryType?
  mealType         String        @default("Lunch")
  imageUrl         String?
  prepTimeMin      Int           @default(20)
  calories         Int
  proteinGrams     Float
  carbsGrams       Float
  fatsGrams        Float
  ingredientsJson  Json
  instructionsJson Json
  dietaryTags      String[]
  createdAt        DateTime      @default(now())

  @@map("recipes")
}

model WaterIntakeLog {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     String
  amountMl Int      @default(0)
  targetMl Int      @default(2500)

  @@unique([userId, date])
  @@map("water_intake_logs")
}

model SleepLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String
  durationHours Float
  qualityRating Int      @default(8)
  notes         String?
  createdAt     DateTime @default(now())

  @@unique([userId, date])
  @@map("sleep_logs")
}

model HabitLog {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                 String
  habitsJson           Json
  completionPercentage Float    @default(0.0)
  updatedAt            DateTime @updatedAt

  @@unique([userId, date])
  @@map("habit_logs")
}

model HabitStreak {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastCompletedDate String?
  updatedAt         DateTime  @updatedAt

  @@map("habit_streaks")
}

model MedicineReminder {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicineName     String
  dosage           String
  scheduleTime     String
  daysOfWeek       String    @default("Everyday")
  instructions     String?
  isEnabled        Boolean   @default(true)
  acknowledgedToday Boolean  @default(false)
  lastTakenAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("medicine_reminders")
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  browserEnabled   Boolean  @default(true)
  checkinTime      String   @default("09:00")
  medicineAlerts   Boolean  @default(true)
  workoutReminders Boolean  @default(true)
  habitReminders   Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("notification_preferences")
}

model WearableConnection {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceType   String
  providerName String
  status       String    @default("CONNECTED")
  lastSyncedAt DateTime? @default(now())
  createdAt    DateTime  @default(now())

  @@unique([userId, providerName])
  @@map("wearable_connections")
}

model WearableMeasurement {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  metricType String
  value      Float
  unit       String
  recordedAt DateTime @default(now())

  @@map("wearable_measurements")
}

model SubscriptionPlan {
  id           String        @id @default(uuid())
  planCode     String        @unique
  category     CategoryType?
  tier         PlanTier
  name         String
  priceInr     Float
  billingCycle String        @default("MONTHLY")
  featuresJson Json
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  category           CategoryType?
  planTier           PlanTier           @default(BASIC)
  amount             Float              @default(0)
  currency           String             @default("INR")
  billingInterval    String             @default("MONTHLY")
  status             SubscriptionStatus @default(ACTIVE)
  startDate          DateTime           @default(now())
  expiryDate         DateTime?
  paymentReference   String?
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId   String?
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])
  amountInr        Float
  currency         String        @default("INR")
  status           String        @default("SUCCESS")
  paymentGateway   String        @default("Razorpay")
  gatewayPaymentId String?
  gatewayOrderId   String?
  receiptUrl       String?
  createdAt        DateTime      @default(now())

  @@map("payments")
}

model Partner {
  id            String      @id @default(uuid())
  name          String
  partnerType   PartnerType
  description   String
  logoUrl       String?
  city          String
  address       String?
  phone         String?
  email         String?
  websiteUrl    String?
  isVerified    Boolean     @default(true)
  rating        Float       @default(4.8)
  discountOffer String?
  createdAt     DateTime    @default(now())

  services PartnerService[]
  bookings PartnerBooking[]

  @@map("partners")
}

model PartnerService {
  id          String   @id @default(uuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  title       String
  serviceType String
  priceInr    Float
  inclusions  String[]
  bookingUrl  String?
  createdAt   DateTime @default(now())

  bookings PartnerBooking[]

  @@map("partner_services")
}

model PartnerBooking {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerId   String
  partner     Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     PartnerService? @relation(fields: [serviceId], references: [id])
  bookingDate DateTime
  status      String          @default("CONFIRMED")
  notes       String?
  createdAt   DateTime        @default(now())

  @@map("partner_bookings")
}

model EmergencyContact {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactName  String
  relationship String
  phoneNumber  String
  isPrimary    Boolean  @default(false)
  consentGiven Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("emergency_contacts")
}

model AIConversation {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  CategoryType?
  title     String        @default("Health Chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  messages AIMessage[]

  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderRole     String
  messageContent String
  timestamp      DateTime       @default(now())

  @@map("ai_messages")
}

model ConsentRecord {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType String
  granted     Boolean  @default(true)
  grantedAt   DateTime @default(now())
  ipAddress   String?

  @@map("consent_records")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  resource    String
  detailsJson Json?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}
